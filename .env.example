# Copy to .env.local for local development. Never commit real secrets.

# --- Contentsquare ---
# Tag id used to build https://t.contentsquare.net/uxa/<id>.js
NEXT_PUBLIC_CS_TAG_ID=506730812ef03
# "false" disables the tag and all _uxa pushes (dataLayer still works)
NEXT_PUBLIC_CS_ENABLED=true

# --- Demo control panel (/demo-controls) ---
# 6+ digit PIN for the panel and its write API. Unset = panel disabled.
DEMO_CONTROLS_PIN=

# --- Global friction flag store ---
# upstash | memory | none. Empty = auto-detect (Upstash vars present -> upstash, else none).
# "memory" is for local dev / Playwright only and is refused on Vercel.
FLAG_STORE=

# Upstash Redis REST (auto-injected by the Vercel Marketplace integration).
# Either the KV_* pair or the UPSTASH_* pair is enough.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Friction flag defaults (build time; on/off, true/false, 1/0) ---
# Empty = use the code default in lib/config.ts. Changing requires a redeploy.
NEXT_PUBLIC_FRICTION_PROMO_FIELD=
NEXT_PUBLIC_FRICTION_SHIPPING_SURPRISE=
NEXT_PUBLIC_FRICTION_DECOY_BANNER=
NEXT_PUBLIC_FRICTION_BURIED_CTA=
NEXT_PUBLIC_FRICTION_DEAD_SWATCH=
NEXT_PUBLIC_FRICTION_SILENT_SIZE=
NEXT_PUBLIC_FRICTION_SLOW_HERO=
NEXT_PUBLIC_FRICTION_POSTCODE_VALIDATION=
NEXT_PUBLIC_FRICTION_EXPRESS_SHIPPING_ERROR=
