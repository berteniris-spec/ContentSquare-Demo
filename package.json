{
  "name": "tidewild-demo-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:m6": "playwright test -c playwright.m6.config.ts",
    "test:variants": "for v in disabled override invalid dev; do VARIANT=$v playwright test -c playwright.variants.config.ts || exit 1; done",
